NODE_ENV=development
PORT=3001
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=eventflow_session
ADMIN_ACCESS_KEY=
# Production only: shared with the Vercel project (server-side var, never VITE_). Same value on both.
PROXY_SHARED_SECRET=
# Production only: "report" (log pass/fail, never block) or "enforce" (403 on fail). Unset or invalid = enforce.
PROXY_LOCK_MODE=enforce
# TEMPORARY (BUGS #079): set to 1 in production to log the X-Forwarded-For entry count and a salted hash of req.ip on login only. Remove once trust proxy is corrected.
# LOGIN_IP_DIAG=1
