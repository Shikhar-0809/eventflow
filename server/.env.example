NODE_ENV=development
PORT=3001
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=eventflow_session
ADMIN_ACCESS_KEY=
# Production only: shared with the Vercel project (server-side var, never VITE_). Same value on both.
PROXY_SHARED_SECRET=
# Production only: "report" (log pass/fail, never block) or "enforce" (403 on fail). Unset or invalid = enforce.
PROXY_LOCK_MODE=enforce
# Email OTP (Brevo). Production needs the first three. Local dev can set EMAIL_DEV_LOG=true to log codes instead of sending (ignored in production).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=EventFlow
EMAIL_DEV_LOG=false
# Secret for hashing email codes in the database: openssl rand -base64 32. Required for sign-up and password reset.
OTP_HMAC_SECRET=
# Optional: app URL shown in emails.
APP_URL=
